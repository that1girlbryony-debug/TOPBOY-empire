# ── TOPBOY EMPIRE — Environment Variables ──────────────────────
# Copy this file to .env and fill in your values.

# MongoDB connection string (required)
# Local: mongodb://localhost:27017/topboy
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/topboy
MONGO_URI=mongodb+srv://your_connection_string_here

# Your WhatsApp phone number (country code + digits, no + or spaces)
# Used for the initial pairing code. After first pairing, the auth
# session is saved and this is no longer needed.
PHONE_NUMBER=2348077016582

# Bot owner phone number (country code + digits)
# This is also set in config.js but env var takes priority if set
# OWNER_NUMBER=2348077016582

# Official group link (shown when bot refuses unauthorized groups)
# BOT_GROUP_LINK=https://chat.whatsapp.com/your-group-invite-code

# Express server port (for keepalive/health check on hosting platforms)
PORT=3000

# ── Optional: YouTube cookie for .play music command ────────────
# Without this, YouTube may rate-limit (429) on datacenter IPs.
# Export cookies from a logged-in YouTube browser session and paste
# the cookie string here. See README for instructions.
# YT_COOKIE=

# ── Hosting platform specific ───────────────────────────────────
# Render.com: set all above in Dashboard → Environment
# Railway: set all above in Variables tab
# VPS: create .env file in the project root
